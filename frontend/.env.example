# ──────────────────────────────────────────────────────────────────────────────
# Saha Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── API ────────────────────────────────────────────────────────────────────────
# Backend base URL used by axios. Defaults to /api/v1 (proxied by Vite).
VITE_API_URL=/api/v1

# ── App metadata ──────────────────────────────────────────────────────────────
# Included in every telemetry event as app_version and environment tags.
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development   # development | staging | production

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Set to "true" to enable OTel trace-context generation.
# In development this can be "false" — the backend still collects server-side
# metrics. Set to "true" in staging and production.
VITE_OTEL_ENABLED=false
